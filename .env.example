# Agentic SDLC Orchestrator — Web (React/Vite) environment example.
# Copy to `.env` for local development. Never commit a real `.env`.

# Backend REST base URL. The API mounts every route under the `/api` prefix (main.ts
# `setGlobalPrefix`), so the prefix belongs here — without it every request 404s.
# The port must match PORT in apps/api/.env.
VITE_API_BASE_URL=http://localhost:3000/api

# WebSocket/SSE endpoint for live planning-run events.
VITE_WS_URL=ws://localhost:3000
