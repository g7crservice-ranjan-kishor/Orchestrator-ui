# Dependencies — restored by `npm install`, never committed. Tens of thousands of files that
# would dwarf the source and make every diff unreadable.
node_modules/

# Build output — regenerated by `npm run build` from the source beside it.
dist/
dist-ssr/
*.local

# Local environment. `.env.example` is committed in its place: it documents which variables exist
# without committing one machine's values, and it is the file a new checkout copies from.
.env
.env.*
!.env.example

# Test and tooling output
coverage/
.vite/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
